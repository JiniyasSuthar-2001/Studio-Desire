# Studio Desire Architecture & Interiors - Environment Configuration Example
# Copy this file to .env and configure strong values before starting the application.

# Application Mode: development / production / testing
ENVIRONMENT="development"
PROJECT_NAME="Studio Desire Architecture & Interiors API"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default; PostgreSQL in production)
DATABASE_URL="sqlite:///./studio_desire.db"

# Security & Authentication (REQUIRED in production: must be at least 32 characters)
# In production, the application will fail to start if SECRET_KEY is missing or weak.
SECRET_KEY="generate-a-strong-random-32-byte-hex-key-here-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# First-Run Initial Admin Credentials (REQUIRED for bootstrapping if no admin user exists)
# Never commit real passwords to version control.
INITIAL_ADMIN_USERNAME="Studio Desire"
INITIAL_ADMIN_EMAIL="studiodesire01@gmail.com"
INITIAL_ADMIN_PASSWORD="StrongInitialAdminPassword123!"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000"

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES=52428800

# Public Enquiry Rate Limiting
ENQUIRY_RATE_LIMIT=10
ENQUIRY_RATE_WINDOW_SECONDS=600

# Frontend URL (Used for OAuth callback redirects)
FRONTEND_URL="http://localhost:5173"

# Google Calendar OAuth 2.0 Credentials
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:8000/api/admin/google-calendar/oauth/callback"
GOOGLE_CALENDAR_SCOPES="https://www.googleapis.com/auth/calendar.events openid email"


